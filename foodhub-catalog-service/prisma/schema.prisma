datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id          String   @id @default(uuid())
  name        String
  price       Float
  place       String
  quantity    Int
  image       String?
  description String?
  category    String
  completed   Boolean? @default(false)
  vendorId    String   // Foreign key referencing Vendor
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Vendor {
  id              String       @id @default(uuid())
  businessName    String
  ownerName       String
  email           String       @unique
  phoneNumber     String
  logo            String?
  description     String?
  street          String
  city            String
  country         String
  plan            String       @default("Starter") 
  subStartDate    DateTime?
  subEndDate      DateTime?
  subStatus       String       @default("active")  
  paymentRef      String?
  products        Product[]    // Relation list back to Product
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}