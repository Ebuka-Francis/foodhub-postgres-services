datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(uuid())
  fullName     String
  email        String    @unique
  password     String
  phoneNumber  String?
  profileImage String?
  dateOfBirth  String?
  gender       String?   // "male" | "female" | "other"
  role         String    @default("customer") // "customer" | "vendor"
  addresses    Address[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Address {
  id      String @id @default(uuid())
  label   String // e.g. "Home", "Work"
  street  String
  city    String
  country String
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}